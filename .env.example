# Copy to .env locally. Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Defaults below are for the local Docker demo only.
DATABASE_URL=postgres://eventmatch:eventmatch_local@127.0.0.1:5432/eventmatch?sslmode=disable
POSTGRES_PASSWORD=eventmatch_local
POSTGRES_PORT=5432
LISTEN_ADDR=127.0.0.1:8080
