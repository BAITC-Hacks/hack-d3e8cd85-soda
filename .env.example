# Optional LLM provider
OPENAI_API_KEY=

# HTTP server port; defaults to 8080
PORT=8080

# Optional: Python executable; the server detects .venv before searching PATH.
PYTHON_EXECUTABLE=
# Optional: exact origin of a separately hosted frontend, e.g. https://events.example
FRONTEND_ORIGIN=

# PostgreSQL: these defaults match compose.yaml.
DATABASE_URL=postgres://eventmatch:eventmatch_local@127.0.0.1:5432/eventmatch?sslmode=disable
POSTGRES_PASSWORD=eventmatch_local
POSTGRES_PORT=5432
